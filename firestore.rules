rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. GLOBAL SAFETY NET
    match /{document=**} {
      allow read, write: if false;
    }

    // PHASE 3: PRIMITIVES
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
             request.auth.token.email == 'rudson.p48@gmail.com' ||
             exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // VALIDATION BLUEPRINTS
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['user', 'admin'] &&
             data.uid.size() < 128;
    }

    function isValidNote(data) {
      return data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 50000;
    }

    function isValidPhoto(data) {
      return data.userId == request.auth.uid &&
             (data.url is string || data.imageUrl is string);
    }

    // 1. USERS COLLECTION
    match /users/{userId} {
      // PII Isolation: Users can read their own full profile, others see public subset (if we had one)
      // For now, allow get if signed in but protect critical fields on update
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 2. ADMINS SEED
    match /admins/{adminId} {
      allow read: if isSignedIn();
    }

    // 3. NOTES
    match /notes/{noteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNote(incoming());
      allow update: if isOwner(existing().userId) && isValidNote(incoming()) &&
                      incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId);
    }

    // 4. PHOTOS
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isSignedIn() && (isValidPhoto(incoming()) || isAdmin());
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && isValidPhoto(incoming())) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes']) && 
         incoming().likes == (existing().likes + 1)) || isAdmin()
      );
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // 5. GLOBAL CONFIGS
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 6. COLLECTIONS MANAGED BY ADMIN
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /devotionals/{devId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /prayers/{prayerId} {
      allow read: if true;
      allow write: if isSignedIn();
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
    
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /live_chat/{msgId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /chat_messages/{msgId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /chat_channels/{channelId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /chat_typing/{typingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /volunteer_schedules/{scheduleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cell_meetings/{meetingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /giving_campaigns/{campaignId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /user_achievements/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // 7. USER PLAYLISTS
    match /user_playlists/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
